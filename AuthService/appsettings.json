{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "AuthDb"
  },

  "JwtSettings": {
    "Secret": "",
    "Issuer": "AuthService",
    "Audience": "AuthServiceUsers",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },

  "GoogleAuth": {
    "ClientId": ""
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "AuthService",
    "SenderEmail": "",
    "AppPassword": ""
  },

  "OtpSettings": {
    "ExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000" ]
  }
}
