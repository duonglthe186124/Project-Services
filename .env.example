ASPNETCORE_ENVIRONMENT=Development
# Auth Database
MongoDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=MyAuthDB
MongoDbSettings__DatabaseName=AuthDb
# Catalog Database (dùng chung ConnectionString hoặc cụm riêng)
CatalogDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=MyAuthDB
CatalogDbSettings__DatabaseName=CatalogDb
# Order Database
OrderDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=MyAuthDB
OrderDbSettings__DatabaseName=OrderDb
# Payment Database
PaymentDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=MyAuthDB
PaymentDbSettings__DatabaseName=PaymentDb
# JWT Shared Secret
JwtSettings__Secret=Thay_Bang_Chuoi_Bi_Mat_Toi_Thieu_32_Ky_Tu
JwtSettings__Issuer=AuthService
JwtSettings__Audience=AuthServiceUsers
# Google Auth
GoogleAuth__ClientId=Thay_Bang_Google_Client_Id.apps.googleusercontent.com
# Email SMTP
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__AppPassword=xxxx xxxx xxxx xxxx
# PaymentService - VietQR & SePay
OrderService__BaseUrl=http://localhost:5267
OrderService__InternalApiKey=
VietQrSettings__BankId=MB
VietQrSettings__AccountNo=YOUR_BANK_ACCOUNT_NUMBER
VietQrSettings__AccountName=YOUR_ACCOUNT_NAME
VietQrSettings__Template=compact2
SePaySettings__ApiKey=YOUR_SEPAY_WEBHOOK_API_KEY
