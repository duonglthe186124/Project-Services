ASPNETCORE_ENVIRONMENT=Development
# Auth Database
MongoDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=MyAuthDB
MongoDbSettings__DatabaseName=AuthDb
# Catalog Database (dùng chung ConnectionString hoặc cụm riêng)
CatalogDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=MyAuthDB
CatalogDbSettings__DatabaseName=CatalogDb
# JWT Shared Secret
JwtSettings__Secret=Thay_Bang_Chuoi_Bi_Mat_Toi_Thieu_32_Ky_Tu
JwtSettings__Issuer=AuthService
JwtSettings__Audience=AuthServiceUsers
# Google Auth
GoogleAuth__ClientId=Thay_Bang_Google_Client_Id.apps.googleusercontent.com
# Email SMTP
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__AppPassword=xxxx xxxx xxxx xxxx